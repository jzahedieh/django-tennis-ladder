#Ignore complile python files
*.pyc

# Ignore root-level json generated by manage.py, but allow Expo/app JSON files
/*.json

# Expo / Node frontend
app/node_modules/
app/.expo/
app/dist/
app/web-build/
app/*.jks
app/*.p8
app/*.p12
app/*.key
app/*.mobileprovision
app/.env.local

#Ignore temporary files created by vim
*.swp

#Ignore prod enviroment variables
.env.prod
.env.local
.env.dev.*

#Ignore run_script folder
/run_script/*

#Ignore and pycharm IDE stuff
.idea/*

#Libreoffice locks
.~lock*

#Ignore logs
/logs/

#Ignore local VENV
/venv/

#Ignore collect static location
/static/

#Ignore data directory (import/export + persist)
/data/*
!/data/nginx/app.conf.template

.devcontainer/*
.venv/

# Assistant instructions
GEMINI.md
